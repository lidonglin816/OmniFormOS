# Copy to .env and restart the local server. Keep the real key in .env only.
# OpenAI-compatible chat/completions endpoint base URL, normally ending in /v1.
OMNIFORM_AI_BASE_URL=
OMNIFORM_AI_API_KEY=
OMNIFORM_AI_MODEL=
# Optional local settings:
PORT=3000
# EXAM_DB_PATH=C:/path/to/examcraft.sqlite
# FLOW_DB_PATH=C:/path/to/flowform.sqlite
# DOC_DB_PATH=C:/path/to/docmorph.sqlite
# ADAPT_DB_PATH=C:/path/to/adaptform.sqlite
# TABLE_DB_PATH=C:/path/to/tablemind.sqlite

# LAB_DB_PATH=C:/path/to/labform.sqlite

# Real Supabase email authentication (optional; local workspace stays available until enabled).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY= # Legacy anon key alternative. Never use a service_role/secret key.
# Canonical origin, no path. Use https://your-domain.example for production.
OMNIFORM_AUTH_APP_URL=http://127.0.0.1:3100
OMNIFORM_AUTH_REQUIRED=false
# Required to authorize access to the EXISTING shared business workspace when auth is enabled.
OMNIFORM_AUTH_ALLOWED_EMAILS=
# Set the same minimum in Supabase Authentication settings.
OMNIFORM_AUTH_PASSWORD_MIN_LENGTH=8
# Optional HTTPS legal document URLs; no placeholder legal policies are shipped.
OMNIFORM_AUTH_TERMS_URL=
OMNIFORM_AUTH_PRIVACY_URL=
# OMNIFORM_AUTH_DATA_PATH=C:/private-path/auth-sessions
